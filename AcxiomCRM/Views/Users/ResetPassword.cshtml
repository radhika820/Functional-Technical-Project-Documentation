@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
<div class="card shadow-sm auth-card">
    <div class="card-body p-4">
        <h1 class="h5 mb-1">Reset password</h1>
        <p class="text-muted small">Set a new password for <strong>@Model.Email</strong>. This also clears any lockout. The event is recorded in the audit log (the password itself is never stored or logged).</p>
        <form method="post" asp-action="ResetPassword" asp-route-id="@Model.Id" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label required-star"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                <div class="form-text">At least 8 characters with upper-case, lower-case, a digit and a symbol.</div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label required-star"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Reset password</button>
            <a class="btn btn-link" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
