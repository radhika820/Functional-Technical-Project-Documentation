@model UserCreateViewModel
@{ ViewData["Title"] = "New user"; }
<h1 class="h4 mb-3">New user</h1>

<form method="post" asp-action="Create" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <div class="card"><div class="card-body"><div class="row g-3">
        <div class="col-md-6">
            <label asp-for="FullName" class="form-label required-star"></label>
            <input asp-for="FullName" class="form-control" maxlength="100" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label required-star"></label>
            <input asp-for="Email" type="email" class="form-control" maxlength="150" autocomplete="off" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Role" class="form-label required-star"></label>
            <select asp-for="Role" class="form-select" asp-items="@CrmItems.From(AppRoles.All, Model.Role)"></select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="ManagerId" class="form-label"></label>
            <select asp-for="ManagerId" class="form-select" asp-items="Model.Managers"><option value="">-- None --</option></select>
            <div class="form-text">Used for Sales Executives; defines the manager's team.</div>
            <span asp-validation-for="ManagerId" class="text-danger"></span>
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <div class="form-check mt-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-md-6">
            <label asp-for="Password" class="form-label required-star"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <div class="form-text">At least 8 characters with upper-case, lower-case, a digit and a symbol.</div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ConfirmPassword" class="form-label required-star"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    </div></div>
    <div class="card-footer text-end">
        <a class="btn btn-link" asp-action="Index">Cancel</a>
        <button type="submit" class="btn btn-primary">Create user</button>
    </div></div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
