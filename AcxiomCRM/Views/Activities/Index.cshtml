@model ActivityListViewModel
@{ ViewData["Title"] = "Activities"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Activities</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Log activity</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="q" value="@Model.Query.Q" class="form-control" placeholder="Subject or description" aria-label="Search" /></div>
    <div class="col-md-2">
        <select name="type" class="form-select" aria-label="Activity type">
            <option value="">All types</option>
            @foreach (var t in ActivityTypes.All) { <option value="@t" selected="@(Model.Query.Type == t)">@t</option> }
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select" aria-label="Status">
            <option value="">All statuses</option>
            @foreach (var t in ActivityStatuses.All) { <option value="@t" selected="@(Model.Query.Status == t)">@t</option> }
        </select>
    </div>
    @if (!User.IsInRole(AppRoles.SalesExecutive))
    {
        <div class="col-md-2">
            <select name="assignedTo" class="form-select" aria-label="Assigned user">
                <option value="">All users</option>
                @foreach (var o in Model.Owners) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
            </select>
        </div>
    }
    <div class="col-md-3 d-flex gap-1">
        <input type="date" name="from" value="@Model.Query.From?.ToString("yyyy-MM-dd")" class="form-control" aria-label="From date" title="From date" />
        <input type="date" name="to" value="@Model.Query.To?.ToString("yyyy-MM-dd")" class="form-control" aria-label="To date" title="To date" />
    </div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Filter</button>
        <a class="btn btn-link" asp-action="Index">Reset</a></div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>@Html.SortLink("Date", "date")</th><th>@Html.SortLink("Type", "type")</th><th>@Html.SortLink("Subject", "subject")</th>
                <th>Related to</th><th>@Html.SortLink("Status", "status")</th><th>@Html.SortLink("Assigned to", "owner")</th><th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var a in Model.Data.Items)
            {
                <tr>
                    <td class="text-nowrap">@AppFormat.Date(a.ActivityDate)</td>
                    <td>@a.ActivityType</td>
                    <td>@a.Subject @if (!string.IsNullOrEmpty(a.Description)) { <div class="small text-muted">@a.Description</div> }</td>
                    <td>
                        @if (a.Customer != null) { <a asp-controller="Customers" asp-action="Details" asp-route-id="@a.CustomerId">@a.Customer.CustomerName</a> }
                        else if (a.Lead != null) { <a asp-controller="Leads" asp-action="Details" asp-route-id="@a.LeadId">@a.Lead.LeadName</a> }
                        else { <text>-</text> }
                    </td>
                    <td>@Ui.StatusBadge(a.Status)</td>
                    <td>@Ui.Owner(a.AssignedUser)</td>
                    <td class="text-end table-actions text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.ActivityId" title="Edit"><i class="bi bi-pencil"></i></a>
                        <form method="post" asp-action="Delete" asp-route-id="@a.ActivityId" data-confirm="Delete this activity?">
                            <button class="btn btn-sm btn-outline-danger" type="submit" title="Delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Data.Items.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No activities found.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-footer"><partial name="_Pager" model="Model.Data" /></div>
</div>
