@model CustomerDetailsViewModel
@{
    var c = Model.Customer;
    ViewData["Title"] = c.CustomerName;
    var addr = string.Join(", ", new[] { c.Address, c.City, c.State }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">@c.CustomerName @Ui.StatusBadge(c.Status)</h1>
        <div class="text-muted">@c.CustomerCode @if (!string.IsNullOrEmpty(c.CompanyName)) { <text>&middot; @c.CompanyName</text> }</div>
    </div>
    <div class="d-flex flex-wrap gap-1">
        <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@c.CustomerId"><i class="bi bi-pencil"></i> Edit</a>
        @if (c.Status == CustomerStatuses.Active)
        {
            <a class="btn btn-outline-success btn-sm" asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@c.CustomerId"><i class="bi bi-plus"></i> Opportunity</a>
        }
        <a class="btn btn-outline-secondary btn-sm" asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@c.CustomerId"><i class="bi bi-alarm"></i> Follow-up</a>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Activities" asp-action="Create" asp-route-customerId="@c.CustomerId"><i class="bi bi-calendar-plus"></i> Activity</a>
        @if (!User.IsInRole(AppRoles.SalesExecutive) && c.Status == CustomerStatuses.Active)
        {
            <form method="post" asp-action="Delete" asp-route-id="@c.CustomerId" data-confirm="Deactivate customer @c.CustomerName? Their history is kept.">
                <button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-person-x"></i> Deactivate</button>
            </form>
        }
        <a class="btn btn-link btn-sm" asp-action="Index">Back</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6"><div class="card h-100"><div class="card-header">Contact</div><div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@c.Email</dd>
            <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@c.Phone</dd>
            <dt class="col-sm-4">Address</dt><dd class="col-sm-8">@(addr.Length > 0 ? addr : "-")</dd>
        </dl></div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header">Account</div><div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Owner</dt><dd class="col-sm-8">@Ui.Owner(c.AssignedUser)</dd>
            <dt class="col-sm-4">Created</dt><dd class="col-sm-8">@AppFormat.DateTimeLocal(c.CreatedDate)</dd>
            <dt class="col-sm-4">Last modified</dt><dd class="col-sm-8">@AppFormat.DateTimeLocal(c.ModifiedDate)</dd>
            <dt class="col-sm-4">Notes</dt><dd class="col-sm-8">@(c.Notes ?? "-")</dd>
        </dl></div></div></div>
</div>

<div class="card mb-3"><div class="card-header">Opportunities (@Model.Opportunities.Count)</div>
    <div class="table-responsive"><table class="table table-sm mb-0 align-middle">
        <thead><tr><th>Name</th><th>Stage</th><th class="text-end">Amount</th><th>Prob.</th><th>Expected close</th></tr></thead>
        <tbody>
        @foreach (var o in Model.Opportunities)
        {
            <tr><td><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId">@o.OpportunityName</a></td>
                <td>@Ui.StatusBadge(o.Stage)</td><td class="text-end">@Html.Money(o.Amount)</td><td>@o.Probability%</td><td>@AppFormat.Date(o.ExpectedCloseDate)</td></tr>
        }
        @if (!Model.Opportunities.Any()) { <tr><td colspan="5" class="text-muted">No opportunities yet.</td></tr> }
        </tbody></table></div></div>

<div class="row g-3 mb-3">
    <div class="col-lg-6"><div class="card h-100"><div class="card-header">Follow-ups</div>
        <ul class="list-group list-group-flush">
            @foreach (var f in Model.FollowUps)
            {
                <li class="list-group-item d-flex justify-content-between"><span><a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId">@f.Subject</a>
                    <span class="text-muted small">&middot; @AppFormat.Date(f.FollowUpDate)</span></span>@Ui.StatusBadge(f.IsOverdue ? "Overdue" : f.Status)</li>
            }
            @if (!Model.FollowUps.Any()) { <li class="list-group-item text-muted">No follow-ups.</li> }
        </ul></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header">Activities</div>
        <ul class="list-group list-group-flush">
            @foreach (var a in Model.Activities)
            {
                <li class="list-group-item d-flex justify-content-between"><span><i class="bi bi-dot"></i>@a.ActivityType: @a.Subject
                    <span class="text-muted small">&middot; @AppFormat.Date(a.ActivityDate)</span></span>@Ui.StatusBadge(a.Status)</li>
            }
            @if (!Model.Activities.Any()) { <li class="list-group-item text-muted">No activities.</li> }
        </ul></div></div>
</div>

@if (Model.Leads.Any())
{
    <div class="card mb-3"><div class="card-header">Converted from leads</div>
        <ul class="list-group list-group-flush">
            @foreach (var l in Model.Leads) { <li class="list-group-item"><a asp-controller="Leads" asp-action="Details" asp-route-id="@l.LeadId">@l.LeadName</a> (@l.LeadCode) &middot; converted @AppFormat.Date(l.ConvertedDate?.ToLocalTime())</li> }
        </ul></div>
}

<div class="card"><div class="card-header">Change history</div>
    <div class="table-responsive"><table class="table table-sm mb-0">
        <thead><tr><th>When</th><th>User</th><th>Action</th><th>Details</th></tr></thead>
        <tbody>
        @foreach (var h in Model.History)
        {
            <tr><td>@AppFormat.DateTimeLocal(h.CreatedDate)</td><td>@h.UserName</td><td>@h.Action</td><td class="small text-muted">@h.Details</td></tr>
        }
        @if (!Model.History.Any()) { <tr><td colspan="4" class="text-muted">No history recorded.</td></tr> }
        </tbody></table></div></div>
