@model CustomerListViewModel
@{ ViewData["Title"] = "Customers"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Customers</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New customer</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="q" value="@Model.Query.Q" class="form-control" placeholder="Search name, email, phone, company or code" aria-label="Search" /></div>
    <div class="col-md-2">
        <select name="status" class="form-select" aria-label="Status">
            <option value="">All statuses</option>
            @foreach (var s in CustomerStatuses.All) { <option value="@s" selected="@(Model.Query.Status == s)">@s</option> }
        </select>
    </div>
    @if (!User.IsInRole(AppRoles.SalesExecutive))
    {
        <div class="col-md-3">
            <select name="assignedTo" class="form-select" aria-label="Owner">
                <option value="">All owners</option>
                @foreach (var o in Model.Owners) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
            </select>
        </div>
    }
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Search</button>
        <a class="btn btn-link" asp-action="Index">Reset</a></div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>@Html.SortLink("Code", "code")</th><th>@Html.SortLink("Customer", "name")</th><th>@Html.SortLink("Company", "company")</th>
                <th>Phone</th><th>@Html.SortLink("Status", "status")</th><th>@Html.SortLink("Owner", "owner")</th><th>@Html.SortLink("Created", "created")</th><th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Data.Items)
            {
                <tr>
                    <td>@c.CustomerCode</td>
                    <td><a asp-action="Details" asp-route-id="@c.CustomerId">@c.CustomerName</a><div class="small text-muted">@c.Email</div></td>
                    <td>@(c.CompanyName ?? "-")</td>
                    <td>@c.Phone</td>
                    <td>@Ui.StatusBadge(c.Status)</td>
                    <td>@Ui.Owner(c.AssignedUser)</td>
                    <td>@AppFormat.Date(c.CreatedDate.ToLocalTime())</td>
                    <td class="text-end table-actions text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@c.CustomerId" title="Details"><i class="bi bi-eye"></i></a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.CustomerId" title="Edit"><i class="bi bi-pencil"></i></a>
                        @if (!User.IsInRole(AppRoles.SalesExecutive) && c.Status == CustomerStatuses.Active)
                        {
                            <form method="post" asp-action="Delete" asp-route-id="@c.CustomerId" data-confirm="Deactivate customer @c.CustomerName? Their history is kept.">
                                <button class="btn btn-sm btn-outline-danger" type="submit" title="Deactivate"><i class="bi bi-person-x"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Data.Items.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No customers found.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-footer"><partial name="_Pager" model="Model.Data" /></div>
</div>
