@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }

<div class="card shadow-sm auth-card">
    <div class="card-body p-4">
        <h1 class="h4 mb-3">Change password</h1>
        <form method="post" asp-action="ChangePassword" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label required-star"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label required-star"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <div class="form-text">At least 8 characters with upper-case, lower-case, a digit and a symbol.</div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label required-star"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Update password</button>
            <a class="btn btn-link" asp-controller="Dashboard" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
