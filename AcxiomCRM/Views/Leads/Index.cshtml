@model LeadListViewModel
@{ ViewData["Title"] = "Leads"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Leads</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New lead</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="q" value="@Model.Query.Q" class="form-control" placeholder="Search lead name, company, email, phone or code" aria-label="Search" /></div>
    <div class="col-md-2">
        <select name="status" class="form-select" aria-label="Status">
            <option value="">All statuses</option>
            @foreach (var s in LeadStatuses.All) { <option value="@s" selected="@(Model.Query.Status == s)">@s</option> }
        </select>
    </div>
    @if (!User.IsInRole(AppRoles.SalesExecutive))
    {
        <div class="col-md-3">
            <select name="assignedTo" class="form-select" aria-label="Assigned user">
                <option value="">All assigned users</option>
                @foreach (var o in Model.Owners) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
            </select>
        </div>
    }
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Search</button>
        <a class="btn btn-link" asp-action="Index">Reset</a></div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>@Html.SortLink("Code", "code")</th><th>@Html.SortLink("Lead", "name")</th><th>@Html.SortLink("Company", "company")</th>
                <th>@Html.SortLink("Source", "source")</th><th>@Html.SortLink("Status", "status")</th><th>@Html.SortLink("Priority", "priority")</th>
                <th class="text-end">@Html.SortLink("Expected value", "value")</th><th>@Html.SortLink("Assigned to", "owner")</th><th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var l in Model.Data.Items)
            {
                <tr>
                    <td>@l.LeadCode</td>
                    <td><a asp-action="Details" asp-route-id="@l.LeadId">@l.LeadName</a><div class="small text-muted">@l.Email</div></td>
                    <td>@(l.CompanyName ?? "-")</td>
                    <td>@l.Source</td>
                    <td>@Ui.StatusBadge(l.Status)</td>
                    <td>@Ui.StatusBadge(l.Priority)</td>
                    <td class="text-end">@Html.Money(l.ExpectedValue)</td>
                    <td>@Ui.Owner(l.AssignedUser)</td>
                    <td class="text-end table-actions text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@l.LeadId" title="Details"><i class="bi bi-eye"></i></a>
                        @if (l.Status != LeadStatuses.Converted)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@l.LeadId" title="Edit"><i class="bi bi-pencil"></i></a>
                            <form method="post" asp-action="Delete" asp-route-id="@l.LeadId" data-confirm="Delete lead @l.LeadName? This cannot be undone.">
                                <button class="btn btn-sm btn-outline-danger" type="submit" title="Delete"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Data.Items.Any()) { <tr><td colspan="9" class="text-center text-muted py-4">No leads found.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-footer"><partial name="_Pager" model="Model.Data" /></div>
</div>
