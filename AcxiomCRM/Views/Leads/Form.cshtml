@model LeadFormViewModel
@{
    var isNew = Model.LeadId == 0;
    ViewData["Title"] = isNew ? "New lead" : "Edit lead";
}
<h1 class="h4 mb-3">@ViewData["Title"]</h1>

<form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? (int?)null : Model.LeadId)" novalidate>
    <input type="hidden" asp-for="LeadId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <div class="card"><div class="card-body"><div class="row g-3">
        <div class="col-md-6">
            <label asp-for="LeadName" class="form-label required-star"></label>
            <input asp-for="LeadName" class="form-control" maxlength="150" />
            <span asp-validation-for="LeadName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CompanyName" class="form-label"></label>
            <input asp-for="CompanyName" class="form-control" maxlength="150" />
            <span asp-validation-for="CompanyName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label required-star"></label>
            <input asp-for="Email" type="email" class="form-control" maxlength="150" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label required-star"></label>
            <input asp-for="Phone" class="form-control" inputmode="numeric" maxlength="10" placeholder="9876543210" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Source" class="form-label required-star"></label>
            <select asp-for="Source" class="form-select" asp-items="@CrmItems.From(LeadSources.All, Model.Source)"></select>
            <span asp-validation-for="Source" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Status" class="form-label required-star"></label>
            <select asp-for="Status" class="form-select" asp-items="@CrmItems.From(Model.StatusOptions ?? LeadStatuses.All.ToList(), Model.Status)"></select>
            <span asp-validation-for="Status" class="text-danger"></span>
            @if (!isNew) { <div class="form-text">Only valid next statuses are listed. Use Convert on a Qualified lead.</div> }
        </div>
        <div class="col-md-3">
            <label asp-for="Priority" class="form-label required-star"></label>
            <select asp-for="Priority" class="form-select" asp-items="@CrmItems.From(LeadPriorities.All, Model.Priority)"></select>
            <span asp-validation-for="Priority" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="ExpectedValue" class="form-label"></label>
            <input asp-for="ExpectedValue" type="number" step="0.01" min="0" max="100000000" class="form-control" />
            <span asp-validation-for="ExpectedValue" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="AssignedTo" class="form-label"></label>
            <select asp-for="AssignedTo" class="form-select" asp-items="Model.Owners"></select>
            <span asp-validation-for="AssignedTo" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1000"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div></div>
    <div class="card-footer text-end">
        <a class="btn btn-link" asp-action="Index">Cancel</a>
        <button type="submit" class="btn btn-primary">Save</button>
    </div></div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
