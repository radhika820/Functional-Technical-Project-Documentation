@model OpportunityDetailsViewModel
@{
    var o = Model.Opportunity;
    ViewData["Title"] = o.OpportunityName;
}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">@o.OpportunityName @Ui.StatusBadge(o.Stage)</h1>
        <div class="text-muted">Customer: <a asp-controller="Customers" asp-action="Details" asp-route-id="@o.CustomerId">@o.Customer?.CustomerName</a></div>
    </div>
    <div class="d-flex flex-wrap gap-1">
        <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@o.OpportunityId"><i class="bi bi-pencil"></i> Edit</a>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@o.OpportunityId"><i class="bi bi-alarm"></i> Follow-up</a>
        @if (!User.IsInRole(AppRoles.SalesExecutive))
        {
            <form method="post" asp-action="Delete" asp-route-id="@o.OpportunityId" data-confirm="Delete opportunity @o.OpportunityName? This cannot be undone.">
                <button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash"></i> Delete</button>
            </form>
        }
        <a class="btn btn-link btn-sm" asp-action="Index">Back</a>
    </div>
</div>

@if (o.IsActive)
{
    <div class="card mb-3"><div class="card-body py-2 d-flex flex-wrap align-items-center gap-2">
        <span class="text-muted small">Move through pipeline:</span>
        @foreach (var s in OpportunityStages.All.Where(s => s != o.Stage))
        {
            <form method="post" asp-action="MoveStage" asp-route-id="@o.OpportunityId" data-confirm="@(s is "Won" or "Lost" ? $"Mark this opportunity as {s}?" : null)">
                <input type="hidden" name="stage" value="@s" />
                <button type="submit" class="btn btn-sm btn-outline-@Ui.Badge(s)">@s</button>
            </form>
        }
    </div></div>
}

<div class="row g-3 mb-3">
    <div class="col-lg-6"><div class="card h-100"><div class="card-header">Deal</div><div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-5">Amount</dt><dd class="col-sm-7">@Html.Money(o.Amount)</dd>
            <dt class="col-sm-5">Probability</dt><dd class="col-sm-7">@o.Probability%</dd>
            <dt class="col-sm-5">Weighted amount</dt><dd class="col-sm-7">@Html.Money(o.WeightedAmount)</dd>
            <dt class="col-sm-5">Expected close date</dt><dd class="col-sm-7">@AppFormat.Date(o.ExpectedCloseDate)</dd>
            <dt class="col-sm-5">Status</dt><dd class="col-sm-7">@Ui.StatusBadge(o.Status)</dd>
            <dt class="col-sm-5">Closed on</dt><dd class="col-sm-7">@AppFormat.Date(o.ClosedDate?.ToLocalTime())</dd>
        </dl></div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header">Details</div><div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Owner</dt><dd class="col-sm-8">@Ui.Owner(o.AssignedUser)</dd>
            <dt class="col-sm-4">Source</dt><dd class="col-sm-8">@(o.Source ?? "-")</dd>
            <dt class="col-sm-4">Lead</dt><dd class="col-sm-8">@if (o.Lead != null) { <a asp-controller="Leads" asp-action="Details" asp-route-id="@o.LeadId">@o.Lead.LeadCode</a> } else { <text>-</text> }</dd>
            <dt class="col-sm-4">Created</dt><dd class="col-sm-8">@AppFormat.DateTimeLocal(o.CreatedDate)</dd>
            <dt class="col-sm-4">Notes</dt><dd class="col-sm-8">@(o.Notes ?? "-")</dd>
        </dl></div></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-6"><div class="card h-100"><div class="card-header">Follow-ups</div>
        <ul class="list-group list-group-flush">
            @foreach (var f in Model.FollowUps)
            {
                <li class="list-group-item d-flex justify-content-between"><span><a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId">@f.Subject</a>
                    <span class="text-muted small">&middot; @AppFormat.Date(f.FollowUpDate)</span></span>@Ui.StatusBadge(f.IsOverdue ? "Overdue" : f.Status)</li>
            }
            @if (!Model.FollowUps.Any()) { <li class="list-group-item text-muted">No follow-ups.</li> }
        </ul></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header">Change history</div>
        <div class="table-responsive"><table class="table table-sm mb-0">
            <thead><tr><th>When</th><th>User</th><th>Action</th><th>Details</th></tr></thead>
            <tbody>
            @foreach (var h in Model.History)
            {
                <tr><td>@AppFormat.DateTimeLocal(h.CreatedDate)</td><td>@h.UserName</td><td>@h.Action</td><td class="small text-muted">@h.Details</td></tr>
            }
            @if (!Model.History.Any()) { <tr><td colspan="4" class="text-muted">No history recorded.</td></tr> }
            </tbody></table></div></div></div>
</div>
