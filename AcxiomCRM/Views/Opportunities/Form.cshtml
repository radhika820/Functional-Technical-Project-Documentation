@model OpportunityFormViewModel
@{
    var isNew = Model.OpportunityId == 0;
    ViewData["Title"] = isNew ? "New opportunity" : "Edit opportunity";
}
<h1 class="h4 mb-3">@ViewData["Title"]</h1>

<form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? (int?)null : Model.OpportunityId)" novalidate>
    <input type="hidden" asp-for="OpportunityId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <div class="card"><div class="card-body"><div class="row g-3">
        <div class="col-md-6">
            <label asp-for="OpportunityName" class="form-label required-star"></label>
            <input asp-for="OpportunityName" class="form-control" maxlength="150" />
            <span asp-validation-for="OpportunityName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CustomerId" class="form-label required-star"></label>
            <select asp-for="CustomerId" class="form-select" asp-items="Model.Customers">
                <option value="0">-- Select customer --</option>
            </select>
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Amount" class="form-label required-star"></label>
            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Stage" class="form-label required-star"></label>
            <select asp-for="Stage" class="form-select" asp-items="@CrmItems.From(OpportunityStages.All, Model.Stage)"></select>
            <span asp-validation-for="Stage" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Probability" class="form-label required-star"></label>
            <input asp-for="Probability" type="number" min="0" max="100" class="form-control" />
            <div class="form-text">Won = 100%, Lost = 0% (set automatically).</div>
            <span asp-validation-for="Probability" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="ExpectedCloseDate" class="form-label required-star"></label>
            <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
            <span asp-validation-for="ExpectedCloseDate" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="LeadId" class="form-label"></label>
            <select asp-for="LeadId" class="form-select" asp-items="Model.Leads"><option value="">-- None --</option></select>
            <span asp-validation-for="LeadId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Source" class="form-label"></label>
            <select asp-for="Source" class="form-select" asp-items="@CrmItems.From(LeadSources.All, Model.Source)"><option value="">-- None --</option></select>
            <span asp-validation-for="Source" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="AssignedTo" class="form-label"></label>
            <select asp-for="AssignedTo" class="form-select" asp-items="Model.Owners"></select>
            <span asp-validation-for="AssignedTo" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1000"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div></div>
    <div class="card-footer text-end">
        <a class="btn btn-link" asp-action="Index">Cancel</a>
        <button type="submit" class="btn btn-primary">Save</button>
    </div></div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
