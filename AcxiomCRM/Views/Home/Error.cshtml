@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="text-center py-5">
    <i class="bi bi-exclamation-octagon display-3 text-danger"></i>
    <h1 class="h3 mt-3">Something went wrong</h1>
    <p class="text-muted">An unexpected error occurred. Please try again; if the problem continues, contact support and quote the reference below.</p>
    @if (!string.IsNullOrEmpty(Model.RequestId)) { <p class="small text-muted">Reference: <code>@Model.RequestId</code></p> }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to home</a>
</div>
